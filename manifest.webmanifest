{
  "id": "./",
  "name": "Atelier — AI Stylist & Smart Wardrobe",
  "short_name": "Atelier",
  "description": "A free, private AI stylist that dresses you from the clothes you already own — with try-on, color season and body-shape analysis.",
  "start_url": "./#/today",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait",
  "background_color": "#f5f1eb",
  "theme_color": "#f5f1eb",
  "categories": ["lifestyle", "shopping", "productivity"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "./?share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": { "title": "title", "text": "text", "url": "url", "files": [{ "name": "image", "accept": ["image/*"] }] }
  },
  "shortcuts": [
    { "name": "Should I buy this?", "url": "./#/shop", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Today’s outfits", "url": "./#/today", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Ask the stylist", "url": "./#/stylist", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Try-On Studio", "url": "./#/tryon", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
